---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

// 从 Middleware 获取 session 和 user
const session = Astro.locals.session;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<Navbar />
		<slot />
    
    <!-- 将 Session 数据安全地传递给客户端 -->
    <script id="supabase-session" type="application/json" is:inline set:html={JSON.stringify(session)}></script>
	</body>
</html>

<script>
  import { supabase } from '../lib/supabase';

  // 1. 立即用水合数据初始化客户端 Session
  let isHydrating = true;
  const sessionElement = document.getElementById('supabase-session') as HTMLElement | null;
  
  async function hydrate(): Promise<void> { // 明确返回 Promise<void>
    if (sessionElement && sessionElement.textContent && sessionElement.textContent !== 'null') {
      const serverSession = JSON.parse(sessionElement.textContent);
      if (serverSession) {
        await supabase.auth.setSession(serverSession);
      }
    }
    isHydrating = false;
  }

  await hydrate().catch(console.error); // 增加 catch 以符合 Promise 处理规范

  // 监听身份验证状态变化 (在浏览器端运行)
  supabase.auth.onAuthStateChange(async (event, session) => {
    const currentPath = window.location.pathname;

    // 如果正在水合且不是初始事件，或者在登录页且没 Session，则忽略
    if (isHydrating) return;
    if (currentPath === '/login' && !session) return;

    try {
      if (event === 'SIGNED_OUT' && !session) {
        // 明确的登出事件，同步清除服务器端 Cookie
        await fetch('/api/clear-session', { method: 'POST' });
        
        const protectedPaths = ['/profile', '/activities']; 
        const isProtected = protectedPaths.some(path => window.location.pathname.startsWith(path));
        
        if (isProtected) {
          window.location.href = '/login';
        }
      } else if (event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED') {
        // 只有当 event 确实改变了 session 时才同步
        if (session) {
          const res = await fetch('/api/set-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ event, session })
          });

          // 修复：如果你正在登录页，确保同步完成后才跳转到 profile
          if (res.ok && currentPath === '/login') {
            window.location.href = '/profile';
          }
        }
      }
    } catch (error) {
      console.error('Supabase Auth State Change Handler Error:', error);
    }
  });
</script>