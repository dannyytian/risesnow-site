---
import MainLayout from '../layouts/MainLayout.astro';
import { getSupabaseClient } from '../lib/supabase';

const supabase = getSupabaseClient(Astro.cookies);
// 直接从 Middleware 获取解析好的 user，避免重复触发 Auth 刷新逻辑
const user = Astro.locals.user;

const { data: activities, error } = await supabase
  .from('activities')
  .select('*')
  .order('date', { ascending: true });

// 获取该用户已报名的所有活动 ID 列表
let userRegistrations: string[] = [];
if (user) {
  const { data: regs } = await supabase
    .from('registrations')
    .select('activity_id')
    .eq('user_id', user.id);
  
  userRegistrations = regs?.map((r: any) => r.activity_id) || [];
}
---

<MainLayout title="Activities - RiseSnow Club">
  <main class="pt-32 px-8 max-w-7xl mx-auto">
    <div class="border-b border-platinum pb-4 mb-12">
      <h2 class="font-serif text-4xl font-bold uppercase tracking-[0.15em] text-slate-900">Upcoming Activities</h2>
      <p class="text-brand-blue/50 text-xs tracking-[0.3em] mt-2 uppercase">近期活动 / 探索你的热雪世界</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {activities?.map((activity) => {
        const isRegistered = userRegistrations.includes(activity.id);
        return (
          <div class="group border border-platinum hover:border-accent-yellow transition-all duration-500 bg-white shadow-sm hover:shadow-xl flex flex-col h-full relative overflow-hidden">
            {/* 活动封面图区域 */}
            <div class="aspect-[16/9] bg-gray-100 overflow-hidden relative">
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent z-10 opacity-60 group-hover:opacity-40 transition-opacity"></div>
              <img 
                src={activity.image_url || 'https://images.unsplash.com/photo-1551698618-1dfe5d97d256?q=80&w=1200&auto=format&fit=crop'} 
                alt={activity.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
              />
              <div class="absolute top-4 left-4 z-20">
                <span class={`text-[10px] px-3 py-1 rounded-sm backdrop-blur-md border uppercase tracking-widest font-medium ${
                  activity.type === 'competition' 
                  ? 'bg-red-500/80 text-white border-red-400' 
                  : 'bg-brand-blue/80 text-white border-brand-blue/40'
                }`}>
                  {activity.type === 'competition' ? 'Competition 比赛' : 'Training 训练'}
                </span>
              </div>
            </div>

            <div class="p-8 flex flex-col flex-grow">
              <div class="flex justify-between items-baseline mb-4">
                <h3 class="font-serif text-2xl font-bold uppercase tracking-tight group-hover:text-accent-yellow transition-colors leading-tight text-slate-900">
                  {activity.title}
                </h3>
                <span class="text-brand-blue/80 text-[10px] tracking-widest font-mono ml-4 shrink-0 font-bold">{activity.date}</span>
              </div>
              
              <p class="text-slate-600 font-normal mb-8 leading-relaxed flex-grow line-clamp-2 text-sm">
                {activity.description}
              </p>

              {/* 关键信息网格 */}
              <div class="grid grid-cols-3 gap-4 mb-8 text-[11px] border-y border-platinum py-4 uppercase tracking-wider">
                <div class="flex flex-col">
                  <span class="text-slate-400 mb-1 font-bold italic">Price 费用</span>
                  <span class="text-slate-900 font-bold text-sm">
                    {activity.price && activity.price > 0 ? `¥${activity.price}` : 'Free 免费'}
                  </span>
                </div>
                <div class="flex flex-col border-x border-platinum px-4">
                  <span class="text-slate-400 mb-1 font-bold italic">Location 地点</span>
                  <span class="text-slate-900 truncate font-bold">{activity.location || 'TBD'}</span>
                </div>
                <div class="flex flex-col pl-4">
                  <span class="text-slate-400 mb-1 font-bold italic">Level 难度</span>
                  <span class="text-slate-900 font-bold">{activity.difficulty || 'All Levels'}</span>
                </div>
              </div>

              <div class="mt-auto flex items-center justify-between">
                <a 
                  href={`/activities/${activity.id}`}
                  class="text-[10px] uppercase tracking-[0.2em] text-slate-500 hover:text-brand-blue transition-colors flex items-center group/link font-bold"
                >
                  Details 详情
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>

                <button
                  class={`register-btn px-6 py-2 text-[10px] uppercase tracking-[0.2em] transition-all duration-300 rounded-sm border font-bold ${
                    isRegistered 
                    ? 'bg-slate-50 border-slate-100 text-slate-300 cursor-default' 
                    : 'bg-slate-900 text-white border-slate-900 hover:bg-accent-yellow hover:border-accent-yellow hover:text-slate-900 cursor-pointer shadow-lg shadow-slate-200'
                  }`}
                  data-id={activity.id}
                  data-title={activity.title}
                  disabled={isRegistered}
                >
                  {isRegistered ? 'Registered 已报名' : 'Register 立即报名'}
                </button>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</MainLayout>

<script>
  import { supabase } from '../lib/supabase';

  // 获取所有报名按钮
  const registerButtons = document.querySelectorAll('.register-btn');
  const toast = document.getElementById('toast');
  const toastMessage = document.getElementById('toast-message');
  const iconSuccess = document.getElementById('toast-icon-success');
  const iconError = document.getElementById('toast-icon-error');

  function showToast(message: string, isError = false) {
    if (!toast || !toastMessage || !iconSuccess || !iconError) return;
    
    toastMessage.textContent = message;
    
    // 根据状态切换背景颜色和图标
    toast.classList.toggle('bg-red-600/90', isError);
    toast.classList.toggle('bg-red-500/90', false); // 清除旧的颜色类
    toast.classList.toggle('bg-brand-blue/90', !isError);
    iconSuccess.classList.toggle('hidden', isError);
    iconError.classList.toggle('hidden', !isError);

    // 进场动画
    toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');

    // 如果不涉及跳转，3秒后自动消失
    setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
    }, 3000);
  }

  registerButtons.forEach(button => {
    button.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const originalText = btn.textContent;
      
      // 进入加载状态
      btn.disabled = true;
      btn.textContent = 'Processing... / 处理中...';

      // 检查 Supabase 登录状态
      const { data: { user } } = await supabase.auth.getUser();

      if (!user) {
        showToast('Please login first! / 请先登录以报名活动！', true);
        setTimeout(() => {
          window.location.href = '/login';
        }, 1000);
      } else {
        const activityId = button.getAttribute('data-id');
        const activityTitle = button.getAttribute('data-title');

        // 将报名信息写入 registrations 表
        const { error } = await supabase
          .from('registrations')
          .insert({
            user_id: user.id,
            activity_id: activityId,
            status: 'pending' // 初始状态为待审核
          });

        if (error) {
          // 如果设置了唯一约束，重复报名会报 23505 错误
          if (error.code === '23505') {
            showToast(`Already registered for "${activityTitle}". / 您已报名过该活动。`, true);
          } else {
            showToast('Registration failed: ' + error.message, true);
          }
          
          // 发生错误时，恢复按钮状态以便用户重试
          btn.disabled = false;
          btn.textContent = originalText;
        } else {
          showToast(`Successfully registered for "${activityTitle}"! / 报名成功！`);
          // 给用户一点时间看清 Toast
          setTimeout(() => {
            window.location.href = '/profile';
          }, 1200);
        }
      }
    });
  });
</script>