---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSupabaseClient } from '../../lib/supabase';

const { id } = Astro.params;
const supabase = getSupabaseClient(Astro.cookies);

// 1. 获取活动详情
const { data: activity, error } = await supabase
  .from('activities')
  .select('*')
  .eq('id', id)
  .single();

// 2. 如果找不到活动，重定向回列表
if (error || !activity) {
  return Astro.redirect('/activities');
}

// 3. 检查当前用户是否已报名
const user = Astro.locals.user; // 确保这里使用的是 middleware 注入的 locals

let registrationStatus: string | null = null;
if (user) {
  const { data: reg } = await supabase
    .from('registrations')
    .select('status')
    .eq('user_id', user.id)
    .eq('activity_id', id)
    .maybeSingle();
  registrationStatus = reg?.status || null;
}
---

<MainLayout title={`${activity.title} - RiseSnow Club`}>
  <main class="pt-32 px-8 max-w-5xl mx-auto pb-24">
    <!-- 返回按钮 -->
    <a href="/activities" class="inline-flex items-center text-[10px] uppercase tracking-[0.2em] text-slate-400 hover:text-brand-blue transition-colors mb-12 font-bold group">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Activities / 返回列表
    </a>

    <article>
      <header class="border-b border-platinum pb-8 mb-12">
        <div class="flex items-center space-x-4 mb-4">
          <span class={`text-[10px] px-3 py-1 rounded-sm border uppercase tracking-widest font-bold ${
            activity.type === 'competition' 
            ? 'bg-red-500 text-white border-red-400' 
            : 'bg-brand-blue text-white border-brand-blue'
          }`}>
            {activity.type === 'competition' ? 'Competition 比赛' : 'Training 训练'}
          </span>
          <span class="text-brand-blue/80 text-[10px] tracking-widest font-mono font-bold uppercase italic">{activity.date}</span>
        </div>
        
        <h1 class="font-serif text-5xl md:text-6xl font-bold uppercase tracking-tight text-slate-900 leading-[1.1] mb-4">
          {activity.title}
        </h1>
        <p class="text-brand-blue/50 text-xs tracking-[0.3em] uppercase">Activity Details / 活动详情</p>
      </header>

      {/* 封面展示 */}
      {activity.image_url && (
        <div class="mb-16 aspect-[21/9] w-full overflow-hidden bg-slate-100 shadow-2xl">
          <img src={activity.image_url} alt={activity.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        <div class="lg:col-span-2">
          <!-- 活动描述 -->
          <div class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:font-bold prose-headings:text-slate-900">
            <h3 class="text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-6 italic">About this activity / 活动介绍</h3>
            <div class="text-slate-600 leading-relaxed whitespace-pre-wrap text-lg font-normal">
              {activity.description}
            </div>
          </div>
        </div>

        <div class="lg:col-span-1">
          <div class="sticky top-32 bg-white border border-platinum p-8 shadow-sm">
            <h3 class="font-serif text-lg font-bold text-slate-900 uppercase tracking-widest mb-8 border-b border-platinum pb-4">Essential Info</h3>
            
            <div class="space-y-8">
              <div class="flex flex-col">
                <span class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.1em] mb-1 italic">Price / 费用</span>
                <span class="text-slate-900 font-bold text-2xl font-serif">{activity.price && activity.price > 0 ? `¥${activity.price}` : 'Free 免费'}</span>
              </div>

              <div class="flex flex-col">
                <span class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.1em] mb-1 italic">Location / 地点</span>
                <span class="text-slate-900 font-bold text-lg">{activity.location || 'TBD'}</span>
              </div>

              <div class="flex flex-col">
                <span class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.1em] mb-1 italic">Difficulty / 难度</span>
                <span class="text-slate-900 font-bold text-lg">{activity.difficulty || 'All Levels'}</span>
              </div>

              <div class="flex flex-col">
                <span class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.1em] mb-1 italic">Status / 状态</span>
                <span class="text-brand-blue font-bold text-lg italic">
                  {registrationStatus === 'pending' ? 'Pending 待审核' : 
                   registrationStatus === 'confirmed' ? 'Confirmed 已确认' : 
                   registrationStatus === 'cancelled' ? 'Cancelled 已取消' :
                   registrationStatus ? registrationStatus : 'Open 开放中'}
                </span>
              </div>
            </div>

            {registrationStatus ? (
              <button disabled class="w-full mt-10 py-4 bg-slate-50 border border-slate-100 text-slate-300 text-[11px] uppercase tracking-[0.3em] font-bold cursor-not-allowed rounded-sm">
                {registrationStatus === 'pending' ? 'Pending Approval 审核中' : 'Already Registered 已报名'}
              </button>
            ) : (
              <a 
                href="/activities" 
                class="block w-full mt-10 py-4 bg-slate-900 text-white text-center text-[11px] uppercase tracking-[0.3em] font-bold hover:bg-accent-yellow hover:text-slate-900 transition-all duration-500 rounded-sm shadow-2xl shadow-slate-300/50 transform hover:-translate-y-1"
              >
                Go to Register / 前往报名
              </a>
            )}
          </div>
        </div>
      </div>
    </article>
  </main>
</MainLayout>

<style>
  .prose p { margin-bottom: 1.5rem; }
</style>