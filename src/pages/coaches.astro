---
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase';

// 从 Supabase 抓取实时教练数据
const { data: coaches, error } = await supabase
  .from('coaches')
  .select('*')
  .eq('status', 'active')
  .order('name', { ascending: true });
---

<MainLayout title="Coaches - RiseSnow Club">
  <main class="pt-32 px-8 max-w-7xl mx-auto">
    <div class="border-b border-platinum pb-4 mb-12">
      <h2 class="font-serif text-4xl font-bold uppercase tracking-[0.15em] text-slate-900">Our Elite Coaches</h2>
      <p class="text-brand-blue/50 text-xs tracking-[0.3em] mt-2 uppercase">我们的精英教练 / 巅峰技艺的传授者</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 pb-24">
      {coaches?.map(coach => {
        // 确定显示的图片：如果 image_url 为空，则根据性别选择对应的默认 WebP 图片
        const displayImage = coach.image_url || 
          (coach.gender === 'Female' ? '/images/coaches/default-female.webp' : '/images/coaches/default-male.webp');

        return (
          <div class="group border border-platinum hover:border-accent-yellow transition-all duration-500 bg-white shadow-sm hover:shadow-xl flex flex-col h-full relative overflow-hidden">
            {/* 教练肖像区域：采用 3:4 比例，更有肖像感 */}
            <div class="aspect-[3/4] bg-slate-100 overflow-hidden relative">
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/20 to-transparent z-10 opacity-70 group-hover:opacity-40 transition-opacity duration-700"></div>
              <img 
                src={displayImage} 
                alt={coach.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
              />
              
              {/* 底部姓名悬浮层 */}
              <div class="absolute bottom-8 left-8 z-20 text-white">
                <p class="text-[10px] uppercase tracking-[0.2em] font-bold mb-1 text-accent-yellow opacity-90">
                  Pro Instructor
                </p>
                <h3 class="font-serif text-3xl md:text-4xl font-bold uppercase tracking-tight leading-none">
                  {coach.name}
                </h3>
              </div>
            </div>

            <div class="p-8 flex flex-col flex-grow">
              {/* 核心资历网格 */}
              <div class="grid grid-cols-2 gap-4 mb-6 text-[10px] border-b border-platinum pb-6 uppercase tracking-wider">
                <div class="flex flex-col">
                  <span class="text-slate-400 mb-1 font-bold italic">Specialty 专长</span>
                  <span class="text-slate-900 font-bold truncate">{coach.specialty || 'All Mountain'}</span>
                </div>
                <div class="flex flex-col border-l border-platinum pl-4">
                  <span class="text-slate-400 mb-1 font-bold italic">Experience 资历</span>
                  <span class="text-slate-900 font-bold">{coach.experience || 'Professional'}</span>
                </div>
              </div>

              {/* 简介 */}
              <p class="text-slate-600 font-normal mb-8 leading-relaxed text-sm line-clamp-3 italic">
                "{coach.bio}"
              </p>

              <div class="mt-auto pt-4 flex items-center justify-between">
                <a 
                  href={`/coaches/${coach.id}`}
                  class="text-[10px] uppercase tracking-[0.2em] text-slate-500 hover:text-brand-blue transition-colors flex items-center group/link font-bold"
                >
                  View Profile 详细资料
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-1 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</MainLayout>