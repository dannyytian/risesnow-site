---
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase';

// 获取前 3 条即将开始的活动
const { data: upcomingEvents, error } = await supabase
  .from('activities')
  .select('*')
  .limit(3)
  .order('date', { ascending: true });

if (error) {
  console.warn('Activities could not be loaded for the homepage:', error.message);
}
---

<MainLayout title="RiseSnow Club | 凌雪技巧">
	<main>
		<!-- Hero Section -->
		<section class="relative h-dvh flex items-center justify-center overflow-hidden bg-brand-blue">
			<!-- Banner 背景容器 -->
			<div class="absolute inset-0 z-0">
				<!-- 磨砂玻璃遮罩：通过模糊背景图并叠加半透明品牌色，显著提升白色文字的可读性 -->
				<div class="absolute inset-0 bg-brand-blue/40 backdrop-blur-[4px] z-10"></div>
				<img 
					src="/banner.png" 
					alt="RiseSnow Club Banner" 
					class="w-full h-full object-cover object-center opacity-70"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			
			<div class="relative z-20 text-center text-white px-4">
				<h1 class="animate-fade-in-up font-serif text-4xl md:text-8xl lg:text-9xl tracking-[0.2em] uppercase mb-2 drop-shadow-2xl">
					RiseSnow
				</h1>
				<h2 class="animate-fade-in-up [animation-delay:150ms] opacity-0 [animation-fill-mode:forwards] font-serif text-2xl md:text-5xl lg:text-6xl tracking-[0.1em] mb-8 drop-shadow-lg">
					凌雪技巧俱乐部
				</h2>
				<p class="animate-fade-in-up [animation-delay:300ms] text-platinum-light tracking-[0.6em] text-xs md:text-sm uppercase font-light mb-12 opacity-0 [animation-fill-mode:forwards]">
					Elevating Your Alpine Experience
				</p>
				<a href="/activities" class="animate-fade-in-up [animation-delay:450ms] opacity-0 [animation-fill-mode:forwards] inline-block px-10 py-4 border border-accent-yellow text-accent-yellow text-xs md:text-sm tracking-[0.3em] uppercase hover:bg-accent-yellow hover:text-brand-blue transition-all duration-500">
					Explore Trips / 探索行程
				</a>
			</div>
		</section>

		<!-- Upcoming Events Section -->
		<section class="py-24 px-8 bg-white">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 border-b border-platinum pb-6">
					<div>
						<h2 class="font-serif text-4xl font-bold uppercase tracking-[0.15em] text-slate-900">Upcoming Events</h2>
						<p class="text-brand-blue/50 text-xs tracking-[0.3em] mt-2 uppercase">近期活动 / 探索热雪世界</p>
					</div>
					<a href="/activities" class="mt-4 md:mt-0 text-[10px] tracking-[0.2em] uppercase text-slate-400 hover:text-brand-blue transition-colors font-bold flex items-center group/all">
						View All 全部活动
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-2 group-hover/all:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
					{upcomingEvents?.map((event) => (
						<a href={`/activities/${event.id}`} class="group flex flex-col h-full bg-white border border-platinum hover:border-accent-yellow transition-all duration-500 shadow-sm hover:shadow-xl relative overflow-hidden">
							<div class="overflow-hidden bg-slate-100 aspect-[4/5] relative">
								<div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent z-10 opacity-60 group-hover:opacity-30 transition-opacity duration-700"></div>
								<img
									src={(event.image_url && event.image_url.trim() !== "") ? event.image_url.split('?')[0] : "https://images.unsplash.com/photo-1551698618-1dfe5d97d256"}
									alt={event.title || "Activity Image"}
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
									loading="lazy"
								/>
							</div>
							
							<div class="p-8 flex flex-col flex-grow">
								<p class="text-brand-blue/80 text-[10px] tracking-widest font-mono font-bold uppercase italic mb-3">{event.date}</p>
								<h3 class="font-serif text-xl font-bold uppercase tracking-tight text-slate-900 group-hover:text-brand-blue transition-colors leading-tight mb-4">
									{event.title}
								</h3>
								<p class="text-slate-600 font-normal text-sm leading-relaxed line-clamp-2 italic mb-6">
									{event.description}
								</p>
								<div class="mt-auto pt-4 border-t border-platinum flex items-center text-[10px] uppercase tracking-[0.2em] text-slate-400 font-bold group-hover:text-slate-900 transition-colors">
									Details 详情
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
</MainLayout>