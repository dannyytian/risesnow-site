---
import MainLayout from '../layouts/MainLayout.astro';
import { getSupabaseClient } from '../lib/supabase';

const { id } = Astro.params;
const supabase = getSupabaseClient(Astro.cookies);

const { data: { user } } = await supabase.auth.getUser();
if (!user) return Astro.redirect('/login');

// 获取活动详情和用户资料
const [activityRes, profileRes] = await Promise.all([
  supabase.from('activities').select('*').eq('id', id).single(),
  supabase.from('profiles').select('*').eq('user_id', user.id).single()
]);

const activity = activityRes.data;
const profile = profileRes.data;

if (!activity) return Astro.redirect('/404');

// 计算年龄逻辑
const calculateAge = (dobString: string | null) => {
  if (!dobString) return null;
  const today = new Date();
  const birthDate = new Date(dobString);
  let age = today.getFullYear() - birthDate.getFullYear();
  const m = today.getMonth() - birthDate.getMonth();
  if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
  return age;
};

const userAge = calculateAge(profile?.date_of_birth);
const isMinor = userAge !== null && userAge < 18;

// 检查资料是否完整
const isProfileIncomplete = !profile?.full_name || 
                            !profile?.date_of_birth || 
                            !profile?.phone || 
                            !profile?.emergency_contact_name || 
                            !profile?.emergency_contact_phone || 
                            !profile?.medical_conditions;
---

<MainLayout title={`Register: ${activity.title} - RiseSnow`}>
  <main class="min-h-screen pt-32 px-8 flex justify-center bg-snow-white font-sans">
    <div class="w-full max-w-2xl">
      <div class="mb-12">
        <h2 class="font-serif text-3xl uppercase tracking-widest text-brand-black mb-2">{activity.title}</h2>
        <p class="text-brand-blue/60">{activity.date} · {activity.location}</p>
      </div>

      <form id="registration-form" class="space-y-8 bg-white p-8 border border-platinum shadow-sm" data-expected-name={profile?.full_name}>
        <input type="hidden" name="activity_id" value={activity.id} />
        
        <!-- 用户信息确认 -->
        <section class="space-y-4">
          <h3 class="text-xs uppercase tracking-widest font-bold border-b border-platinum pb-2">Member Information</h3>
          <div class="grid grid-cols-2 gap-4 text-sm">
            <p><span class="text-brand-black/40 uppercase text-[10px] block">Participant</span> {profile?.full_name}</p>
            <p><span class="text-brand-black/40 uppercase text-[10px] block">Age</span> {userAge ?? 'N/A'} (DOB: {profile?.date_of_birth})</p>
            <p><span class="text-brand-black/40 uppercase text-[10px] block">Phone</span> {profile?.phone || 'Missing'}</p>
            <p><span class="text-brand-black/40 uppercase text-[10px] block">Emergency Contact</span> {profile?.emergency_contact_name || 'Missing'} ({profile?.emergency_contact_phone || 'Missing'})</p>
          </div>
          <div class="mt-2 text-sm">
            <span class="text-brand-black/40 uppercase text-[10px] block">Medical Conditions</span>
            <p class="text-brand-blue/80 italic">{profile?.medical_conditions || 'None stated'}</p>
          </div>
          {isProfileIncomplete && (
            <div class="p-4 bg-red-50 text-red-600 text-xs italic">
              Your profile is incomplete (Missing phone, emergency contact or medical info). Please <a href="/profile" class="underline">complete your profile</a> before registering.
            </div>
          )}
        </section>

        <!-- 免责声明勾选 -->
        <section class="space-y-4 pt-4">
          <div class="flex items-start gap-3 p-4 bg-platinum/10 border border-platinum/50 rounded">
            <input type="checkbox" id="agree_waiver" required class="mt-1 accent-brand-black" />
            <label for="agree_waiver" class="text-xs text-brand-black/70 leading-relaxed">
              I have read and agree to the <strong>Liability Waiver and Release</strong>. I understand that skiing/snowboarding involves inherent risks.
            </label>
          </div>
        </section>

        <!-- 未成年人专用区块 -->
        {isMinor && (
          <section id="minor-consent-block" class="p-6 bg-gold-accent/5 border border-gold-accent/20 rounded-lg space-y-4">
            <h3 class="text-xs uppercase tracking-widest font-bold text-gold-accent flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
              Guardian Consent Required
            </h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <input type="checkbox" id="guardian_confirm" required class="mt-1 accent-gold-accent" />
                <label for="guardian_confirm" class="text-[11px] font-semibold text-brand-black leading-snug">
                  As the parent or legal guardian of the minor named above, I hereby give my consent for their participation in this activity.
                </label>
              </div>
              <div>
                <label class="block text-[10px] uppercase font-bold mb-2">Guardian Full Name / 监护人全名</label>
                <input 
                  type="text" 
                  name="guardian_signature" 
                  required={isMinor}
                  class="w-full px-4 py-3 border border-platinum focus:border-gold-accent outline-none font-serif italic" 
                  placeholder="Type your name to sign"
                />
              </div>
            </div>
          </section>
        )}

        <!-- 最终电子签名 -->
        <section class="pt-6 border-t border-platinum">
          <label class="block text-[10px] uppercase font-bold mb-2">
            {isMinor ? "Participant Acknowledgement / 参与者确认" : "Electronic Signature / 电子签名"}
          </label>
          <input 
            type="text" 
            id="final_signature" 
            name="member_signature" 
            required 
            class="w-full px-4 py-3 border border-platinum focus:border-gold-accent outline-none" 
            placeholder={profile?.full_name}
          />
        </section>

        <button 
          type="submit" 
          id="reg-submit-btn"
          disabled={isProfileIncomplete}
          class="w-full bg-brand-black text-white font-bold uppercase tracking-widest py-4 hover:bg-gold-accent transition-all disabled:opacity-30"
        >
          Confirm Registration
        </button>
      </form>
    </div>
  </main>
</MainLayout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('registration-form') as HTMLFormElement;
  const submitBtn = document.getElementById('reg-submit-btn') as HTMLButtonElement;
  const expectedName = form?.dataset.expectedName;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    
    // 1. 基础校验：签名匹配
    const signature = (formData.get('member_signature') as string)?.trim();
    if (signature !== expectedName) {
      alert(`Signature must match your full name: ${expectedName}`);
      return;
    }

    // 2. 状态反馈
    submitBtn.disabled = true;
    submitBtn.textContent = 'Processing...';

    const activityId = formData.get('activity_id');
    
    // 获取当前客户端 Session
    const { data: { user }, error: authError } = await supabase.auth.getUser();

    if (authError || !user) {
      alert('Your session has expired. Please login again. / 登录已过期，请重新登录。');
      window.location.href = '/login';
      return;
    }

    try {
      // 3. 检查是否重复报名
      const { data: existing } = await supabase
        .from('registrations')
        .select('id')
        .eq('activity_id', activityId)
        .eq('user_id', user.id)
        .single();

      if (existing) {
        alert('You are already registered for this activity.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Confirm Registration';
        return;
      }

      // 4. 检查容量 (NzMoguls 核心逻辑)
      const { data: event } = await supabase.from('activities').select('capacity').eq('id', activityId).single();
      const { count } = await supabase.from('registrations').select('*', { count: 'exact', head: true }).eq('activity_id', activityId);

      if (event?.capacity && count !== null && count >= event.capacity) {
        alert('Sorry, this activity is full.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Activity Full';
        return;
      }

      // 5. 提交报名
      const regData = {
        activity_id: activityId,
        user_id: user.id,
        status: 'pending',
        // 如果是未成年人，这里可以保存监护人签名到特定字段或备注
        notes: formData.get('guardian_signature') ? `Guardian Signed: ${formData.get('guardian_signature')}` : null
      };

      const { error: regError } = await supabase.from('registrations').insert([regData]);
      if (regError) throw regError;

      alert('Successfully registered!');
      window.location.href = '/profile';

    } catch (err: any) {
      alert(err.message || 'An error occurred during registration.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirm Registration';
    }
  });
</script>